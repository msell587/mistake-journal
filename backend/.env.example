# Copy to backend/.env. These are grammar-agent's normal settings.

# Real checking with Google Gemini's free tier (key from https://aistudio.google.com/apikey)
GRAMMAR_AGENT_PROVIDER=gemini
GEMINI_API_KEY=

# Or try the app offline with scripted demo replies (no key needed):
# GRAMMAR_AGENT_PROVIDER=mock
# GRAMMAR_AGENT_MOCK_SCRIPT=demo/demo_replies.json

# Where journal entries are stored
# MISTAKE_JOURNAL_DB=sqlite:///./mistake_journal.db
